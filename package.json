{
  "name": "odoo-health-ext-cs",
  "version": "1.2.1",
  "private": true,
  "description": "Fast, safe account health and industry updates for Odoo Customer Success.",
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wxt -b chrome --mv3",
    "dev:firefox": "wxt -b firefox --mv3",
    "prepare": "wxt prepare",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:release-state": "node --test tests/release-state.node.mjs",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:run && pnpm test:release-state",
    "build:chrome": "wxt build -b chrome --mv3",
    "build:firefox": "wxt build -b firefox --mv3",
    "release:status": "node scripts/verify-release-state.mjs status",
    "verify:development-state": "node scripts/verify-release-state.mjs development",
    "verify:release-state": "node scripts/verify-release-state.mjs release",
    "validate:manifests": "node scripts/validate-manifests.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3",
    "scan": "node scripts/scan-sensitive.mjs",
    "package:artifacts": "node scripts/package-artifacts.mjs",
    "package": "pnpm icons && pnpm validate && pnpm verify:development-state && pnpm build:chrome && pnpm build:firefox && pnpm validate:manifests && pnpm lint:firefox && pnpm scan && pnpm package:artifacts",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@wxt-dev/module-react": "1.2.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.17.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "5.1.1",
    "archiver": "^7.0.1",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fast-glob": "^3.3.3",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sharp": "^0.34.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.4",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
